{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // DOM only. The renderer is sandboxed with no Node integration, so a Node
    // global that type-checks here is a runtime bug waiting to happen.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/renderer/**/*", "src/types/**/*"]
}
