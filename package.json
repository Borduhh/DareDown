{
  "name": "daredown",
  "productName": "DareDown",
  "version": "1.0.1",
  "description": "A markdown reader that isn't afraid of anything — not even your gnarliest .md files.",
  "private": true,
  "author": {
    "name": "Borduhh",
    "email": "4759596+Borduhh@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Borduhh/DareDown",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borduhh/DareDown.git"
  },
  "bugs": {
    "url": "https://github.com/Borduhh/DareDown/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Borduhh"
  },
  "keywords": [
    "markdown",
    "reader",
    "viewer",
    "mermaid",
    "electron",
    "offline"
  ],
  "main": "src/main/index.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch --electron",
    "start": "npm run build && electron .",
    "open:samples": "npm run build && electron . samples/README.md",
    "harness": "node scripts/build.mjs --harness",
    "pack": "npm run release:prep && electron-builder --dir --publish never",
    "dist": "npm run release:prep && electron-builder -mwl --publish never",
    "dist:mac": "npm run release:prep && electron-builder --mac --publish never",
    "dist:win": "npm run release:prep && electron-builder --win --publish never",
    "dist:linux": "npm run release:prep && electron-builder --linux --publish never",
    "release:prep": "node scripts/check-icon.mjs && npm run build",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "commitlint": "commitlint --from origin/main --to HEAD --verbose"
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "semantic-release": "^25.0.9"
  },
  "build": {
    "appId": "com.borduhh.daredown",
    "productName": "DareDown",
    "copyright": "Copyright © 2026 borduhh",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "dist/renderer/index.html",
      "dist/renderer/app.js",
      "dist/renderer/app.css",
      "!**/*.map"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdx",
          "qmd"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "text/markdown"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "DareDown ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DareDown"
    },
    "linux": {
      "category": "Office;Viewer;TextEditor",
      "synopsis": "Offline Markdown reader",
      "description": "A markdown reader that isn't afraid of anything — not even your gnarliest .md files. Offline, view-only, with first-class Mermaid diagram support.",
      "desktop": {
        "entry": {
          "MimeType": "text/markdown;text/x-markdown"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "Borduhh <4759596+Borduhh@users.noreply.github.com>"
    },
    "afterPack": "scripts/after-pack.mjs"
  }
}
